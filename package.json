{
  "name": "signalforge",
  "version": "0.1.0",
  "type": "module",
  "description": "A self-contained OXLint plugin for low-evidence code, slop signals, and architecture drift.",
  "license": "MIT",
  "author": "Signalforge contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namuan/signalforge.git"
  },
  "bugs": {
    "url": "https://github.com/namuan/signalforge/issues"
  },
  "homepage": "https://github.com/namuan/signalforge#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/rules.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.77.0",
    "@types/node": "22.18.0",
    "oxlint": "1.77.0",
    "typescript": "5.9.3"
  }
}
